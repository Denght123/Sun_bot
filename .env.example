APP_NAME=Sun Bot
APP_ENV=development
APP_DESCRIPTION=a finacial bot
APP_VERSION=v1.0.0
APP_HOST=0.0.0.0
APP_PORT=8000
API_PREFIX=/api
TIMEZONE=Asia/Shanghai
LOG_LEVEL=INFO

# Shared auth tokens
ADMIN_TOKEN=<fill-admin-token>
SENDER_TOKEN=<fill-sender-token>

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=finance_news
POSTGRES_USER=finance_news
POSTGRES_PASSWORD=<fill-postgres-password>
DATABASE_URL=

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=

# Scheduler / dispatch core
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Shanghai
DAILY_DISPATCH_HOUR=8
DAILY_DISPATCH_MINUTE=0
DISPATCH_MAX_RETRY=3
DISPATCH_STALE_TIMEOUT_SECONDS=300
SCHEDULER_STARTUP_RECONCILE=true
SCHEDULER_RECOVERY_INTERVAL_SECONDS=60
SCHEDULER_MISFIRE_GRACE_SECONDS=900

# Primary delivery contract: backend -> WeCom app messaging
# This branch only establishes the config contract and architecture direction.
# Actual WeCom sending implementation remains follow-up work.
DISPATCH_PROVIDER=wecom_app
DISPATCH_EXECUTION_MODE=backend
WECOM_ENABLED=true
WECOM_API_BASE_URL=https://qyapi.weixin.qq.com/cgi-bin
WECOM_CORP_ID=<fill-wecom-corp-id>
WECOM_AGENT_ID=<fill-wecom-agent-id>
WECOM_SECRET=<fill-wecom-secret>
WECOM_DEFAULT_TOUSER=
WECOM_DEFAULT_TOPARTY=
WECOM_DEFAULT_TOTAG=
WECOM_MESSAGE_TYPE=text
WECOM_SAFE=0
WECOM_TOKEN_REFRESH_BUFFER_SECONDS=300
WECOM_CALLBACK_ENABLED=false
WECOM_CALLBACK_TOKEN=
WECOM_CALLBACK_AES_KEY=

# Collectors
COLLECTOR_REQUEST_TIMEOUT_SECONDS=10
COLLECTOR_USER_AGENT=finance-news-bot/0.1
CLS_BASE_URL=https://www.cls.cn/telegraph
BAIDU_HOTSEARCH_URL=https://top.baidu.com/board?tab=realtime
CANDIDATE_EVENT_LIMIT_PER_SECTION=20

# LLM
LLM_ENABLED=true
LLM_API_URL=<fill-llm-api-url>
LLM_API_KEY=<fill-your-llm-api-key>
LLM_MODEL=<fill-llm-model>
LLM_TIMEOUT_SECONDS=20

# Legacy sender-agent fallback only
# Use these when DISPATCH_PROVIDER=sender_agent or when running fallback / rollback drills.
# SENDER_API_BASE_URL points to the backend API, not to the WeCom API.
DISPATCH_DEFAULT_TARGET_USER=<fill-wechat-remark-name>
SENDER_ONLINE_THRESHOLD_SECONDS=60
SENDER_DEGRADED_THRESHOLD_SECONDS=180
SENDER_NEXT_HEARTBEAT_SECONDS=30
SENDER_API_BASE_URL=<fill-backend-api-base-url>
SENDER_ID=sender-win-001
SENDER_HEARTBEAT_INTERVAL_SEC=30
SENDER_POLL_INTERVAL_SEC=5
SENDER_REQUEST_TIMEOUT_SEC=10
SENDER_TASK_LIMIT=1
SENDER_TIMEZONE=Asia/Shanghai
SENDER_LOG_LEVEL=INFO
SENDER_CLIENT_VERSION=0.1.0
SENDER_LOCAL_STATE_DIR=
SENDER_LOG_FILE=
SENDER_JOURNAL_PATH=
SENDER_HEARTBEAT_IP=
WECHAT_WINDOW_TITLE_HINT=微信
WECHAT_SEND_DELAY_MS=300
WECHAT_CHAT_SEARCH_TIMEOUT_SEC=10
